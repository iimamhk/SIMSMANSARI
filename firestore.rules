rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helper peran & identitas ----
    // Login memakai custom token (api/_lib/auth.js) yang membawa klaim `role`
    // ('admin'|'guru'|'siswa') dan `username`. Helper ini dipakai untuk
    // menegakkan otorisasi berbasis peran, bukan sekadar "sudah login".
    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isStaff() { return isSignedIn() && (role() == 'guru' || role() == 'admin'); }

    match /dashboard_counts/{periodId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /materi_publish/{materialId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.role == 'guru' && request.resource.data.guru_id == request.auth.token.username && request.resource.data.keys().hasOnly([
        'id',
        'source_id',
        'pengajaran_id',
        'kelas_id',
        'kelas_nama',
        'kelas_token',
        'kelas_ids',
        'kelas_nama_csv',
        'pengajaran_ids',
        'mapel_id',
        'mapel_nama',
        'guru_id',
        'guru_nama',
        'title',
        'level',
        'chapter',
        'meetings',
        'note',
        'html_source',
        'markdown_source',
        'source',
        'doc_mode',
        'document_json',
        'gaya',
        'created_at',
        'updated_at',
        'tahun_ajaran_id',
        'semester_id',
        'status',
        'visible_to_students',
        'published_at'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == materialId
      && request.resource.data.id.size() > 0
      && request.resource.data.pengajaran_id is string
      && request.resource.data.kelas_id is string
      && request.resource.data.kelas_nama is string
      && request.resource.data.kelas_token is string
      // Struktur baru: satu dokumen materi untuk banyak kelas.
      && (!('kelas_ids' in request.resource.data) || (request.resource.data.kelas_ids is list && request.resource.data.kelas_ids.size() <= 60))
      && (!('pengajaran_ids' in request.resource.data) || (request.resource.data.pengajaran_ids is list && request.resource.data.pengajaran_ids.size() <= 60))
      && (!('kelas_nama_csv' in request.resource.data) || request.resource.data.kelas_nama_csv is string)
      && request.resource.data.mapel_id is string
      && request.resource.data.mapel_nama is string
      && request.resource.data.guru_id is string
      && request.resource.data.guru_nama is string
      && request.resource.data.title is string
      && request.resource.data.level is string
      && request.resource.data.chapter is string
      && request.resource.data.meetings is string
      && request.resource.data.note is string
      && request.resource.data.html_source is string
      && request.resource.data.html_source.size() <= 700000
      && request.resource.data.tahun_ajaran_id is string
      && request.resource.data.semester_id is string
      && request.resource.data.status is string
      && request.resource.data.status in ['published', 'unpublished']
      && request.resource.data.created_at is string
      && request.resource.data.updated_at is string
      && (!('markdown_source' in request.resource.data) || request.resource.data.markdown_source is string)
      && (!('source_id' in request.resource.data) || request.resource.data.source_id is string)
      && (!('source' in request.resource.data) || request.resource.data.source is string)
        && (!('published_at' in request.resource.data) || request.resource.data.published_at is string)
        && (!('doc_mode' in request.resource.data) || request.resource.data.doc_mode is string)
        && (!('document_json' in request.resource.data) || request.resource.data.document_json == null || request.resource.data.document_json is map)
        && (!('gaya' in request.resource.data) || request.resource.data.gaya is string)
        && request.resource.data.visible_to_students is bool;

      allow delete: if request.auth != null && resource.data.guru_id == request.auth.token.username;
    }

    match /materi_workspace_drafts/{draftId} {
      allow read, delete: if request.auth != null
        && resource.data.guru_id == request.auth.token.username;
      allow create, update: if request.auth != null
        && request.auth.token.role == 'guru'
        && request.resource.data.guru_id == request.auth.token.username
        && request.resource.data.id == draftId
        && request.resource.data.keys().hasOnly([
          'id', 'guru_id', 'guru_nama', 'title', 'subject', 'class_name', 'duration',
          'chapter', 'gaya', 'note', 'source', 'doc_mode', 'schema_version', 'document_json', 'html_source',
          'tahun_ajaran_id', 'semester_id', 'updated_at', 'created_at'
        ])
        && request.resource.data.id is string
        && request.resource.data.guru_id is string
        && request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.class_name is string
        && request.resource.data.duration is string
        && request.resource.data.schema_version is int
        // Draft manual menyimpan struktur blok (map); draft AI/Import menyimpan HTML
        // sehingga document_json bernilai null.
        && (request.resource.data.document_json == null || request.resource.data.document_json is map)
        && (!('html_source' in request.resource.data) || request.resource.data.html_source is string)
        && (!('source' in request.resource.data) || request.resource.data.source in ['manual', 'ai', 'import'])
        && (!('doc_mode' in request.resource.data) || request.resource.data.doc_mode in ['manual', 'ai', 'import', 'html', 'structured'])
        && (!('guru_nama' in request.resource.data) || request.resource.data.guru_nama is string)
        && (!('chapter' in request.resource.data) || request.resource.data.chapter is string)
        && (!('gaya' in request.resource.data) || request.resource.data.gaya is string)
        && (!('note' in request.resource.data) || request.resource.data.note is string)
        && (!('tahun_ajaran_id' in request.resource.data) || request.resource.data.tahun_ajaran_id is string)
        && (!('semester_id' in request.resource.data) || request.resource.data.semester_id is string)
        && request.resource.data.updated_at is string
        && request.resource.data.created_at is string;
    }

    match /materi_reads/{readId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.keys().hasOnly([
        'id',
        'material_id',
        'siswa_id',
        'siswa_nama',
        'kelas_id',
        'kelas_nama',
        'guru_id',
        'guru_nama',
        'mapel_nama',
        'material_title',
        'event_type',
        'read_count',
        'first_read_at',
        'last_read_at',
        'last_duration_seconds',
        'total_duration_seconds',
        'completed_at',
        'completion_status',
        'tahun_ajaran_id',
        'semester_id'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == readId
      && request.resource.data.material_id is string
      && request.resource.data.siswa_id is string
      && request.resource.data.siswa_nama is string
      && request.resource.data.kelas_id is string
      && request.resource.data.kelas_nama is string
      && request.resource.data.guru_id is string
      && request.resource.data.guru_nama is string
      && request.resource.data.mapel_nama is string
      && request.resource.data.material_title is string
      && request.resource.data.event_type is string
      && request.resource.data.read_count is int
      && request.resource.data.read_count >= 0
      && request.resource.data.first_read_at is string
      && request.resource.data.last_read_at is string
      && request.resource.data.last_duration_seconds is int
      && request.resource.data.last_duration_seconds >= 0
      && request.resource.data.total_duration_seconds is int
      && request.resource.data.total_duration_seconds >= 0
      && request.resource.data.completion_status is string
      && request.resource.data.completion_status in ['unopened', 'opened', 'completed']
      && request.resource.data.tahun_ajaran_id is string
      && request.resource.data.semester_id is string
      && (!('completed_at' in request.resource.data) || request.resource.data.completed_at is string);
      allow delete: if request.auth != null;
    }

    match /game_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly([
        'id', 'config_id', 'game_type', 'tahun_ajaran_id', 'semester_id',
        'pengajaran_id', 'guru_id', 'kelas_id', 'siswa_id', 'siswa_nama',
        'started_at', 'finished_at', 'duration_used_sec', 'quiz_type', 'timeout',
        'score', 'accuracy', 'correct_count', 'total_questions', 'wrong_count',
        'by_operation', 'by_theme', 'questions', 'words_to_review',
        'mastered_words', 'review_count'
      ])
      && request.resource.data.id is string
      && request.resource.data.game_type in ['math', 'english_vocab']
      && request.resource.data.siswa_id is string
      && request.resource.data.pengajaran_id is string
      && request.resource.data.score is int
      && request.resource.data.correct_count is int
      && request.resource.data.total_questions is int;
       allow update, delete: if request.auth != null;
    }

    match /game_session_rekap/{rekapId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn() && request.resource.data.keys().hasOnly([
        'id', 'game_type', 'pengajaran_id', 'kelas_id', 'kelas_nama',
        'siswa_id', 'siswa_nama', 'tahun_ajaran_id', 'semester_id',
        'session_id', 'started_at', 'finished_at',
        'raw_score', 'raw_correct', 'raw_total',
        'nilai_asli', 'nilai_rekap', 'attempt_number',
        'per_operation', 'per_theme', 'per_category', 'per_round', 'per_mission',
        'created_at', 'updated_at'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == rekapId
      && request.resource.data.game_type in ['math', 'english_vocab', 'matching', 'battle', 'daily']
      && request.resource.data.siswa_id is string
      && request.resource.data.pengajaran_id is string
      && request.resource.data.session_id is string
      && request.resource.data.nilai_asli is string
      && request.resource.data.nilai_rekap is int
      && request.resource.data.attempt_number is int
      && request.resource.data.raw_correct is int
      && request.resource.data.raw_total is int;
       allow update, delete: if request.auth != null;
    }

    // Quiz Battle MVP. Aplikasi saat ini memakai login lokal, bukan Firebase Auth,
    // sehingga rules mengikuti pola koleksi game lama dan memvalidasi bentuk payload.
    match /battle_rooms/{roomId} {
      allow read: if request.auth != null;
      // Membuat/menyunting struktur room adalah wewenang GURU pemilik. Sebelumnya
      // setiap pengguna login dapat membuat room dengan guru_id siapa pun
      // (impersonasi). Kini create/update bentuk-penuh wajib guru & guru_id ==
      // username sendiri. Siswa TIDAK menulis battle_rooms secara langsung
      // (mereka bergabung lewat koleksi battle_participants).
      allow create, update: if isSignedIn()
        && role() == 'guru'
        && request.resource.data.guru_id == request.auth.token.username
        && request.resource.data.keys().hasOnly([
        'id', 'code', 'title', 'game_type', 'battle_game_type', 'subject_label', 'battle_settings', 'mode', 'status', 'current_question',
        'time_per_question', 'questions', 'participants', 'guru_id', 'guru_nama',
        'kelas_id', 'kelas_nama', 'pengajaran_id', 'tahun_ajaran_id', 'semester_id',
        'created_at', 'updated_at', 'started_at', 'finished_at'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == roomId
      && request.resource.data.code is string
      && request.resource.data.code.size() == 6
      && request.resource.data.title is string
      && request.resource.data.game_type == 'battle'
      && request.resource.data.battle_game_type in ['math', 'english_vocab']
      && request.resource.data.subject_label is string
      && request.resource.data.battle_settings is map
      && request.resource.data.mode == 'individual'
      && request.resource.data.status in ['waiting', 'live', 'finished']
      && request.resource.data.current_question is int
      && request.resource.data.current_question >= 0
      && request.resource.data.time_per_question is int
      && request.resource.data.time_per_question in [15, 20, 30]
      && request.resource.data.questions is list
      && request.resource.data.questions.size() >= 1
      && request.resource.data.questions.size() <= 20
      && request.resource.data.participants is map
      && request.resource.data.guru_id is string
      && request.resource.data.kelas_id is string
      && request.resource.data.pengajaran_id is string
      && request.resource.data.tahun_ajaran_id is string
      && request.resource.data.semester_id is string
      && request.resource.data.created_at is string
      && request.resource.data.updated_at is string
      && (!('guru_nama' in request.resource.data) || request.resource.data.guru_nama is string)
      && (!('kelas_nama' in request.resource.data) || request.resource.data.kelas_nama is string)
      && (!('started_at' in request.resource.data) || request.resource.data.started_at is string)
      && (!('finished_at' in request.resource.data) || request.resource.data.finished_at is string);
      allow update: if request.auth != null
        && ((resource.data.guru_id == request.auth.token.username
          && request.resource.data.guru_id == resource.data.guru_id)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'updated_at'])
          && request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.token.username])));
      allow delete: if request.auth != null && resource.data.guru_id == request.auth.token.username;
    }

    match /battle_participants/{participantId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.participant_id == request.auth.token.username && request.resource.data.keys().hasOnly([
        'id', 'participant_id', 'room_id', 'room_code', 'nama', 'score', 'correct', 'wrong', 'answers', 'score_events',
        'avatar_key', 'avatar_seed', 'ready',
        'joined_at', 'last_seen_at', 'updated_at'
      ])
      && request.resource.data.id is string
      && request.resource.data.id == participantId
      && request.resource.data.participant_id is string
      && request.resource.data.room_id is string
      && request.resource.data.room_code is string
      && request.resource.data.room_code.size() == 6
      && request.resource.data.nama is string
      && request.resource.data.score is int
      && request.resource.data.score >= 0
      && request.resource.data.correct is int
      && request.resource.data.correct >= 0
      && request.resource.data.wrong is int
      && request.resource.data.wrong >= 0
      && request.resource.data.answers is map
      && request.resource.data.score_events is map
      && request.resource.data.avatar_key is string
      && request.resource.data.avatar_seed is string
      && request.resource.data.ready is bool
      && request.resource.data.joined_at is string
      && request.resource.data.updated_at is string
      && (!('last_seen_at' in request.resource.data) || request.resource.data.last_seen_at is string);
       allow delete: if request.auth != null && resource.data.participant_id == request.auth.token.username;
    }

    // Public lobby content is rendered before authentication on the home page.
    // Reads tetap publik; menulis konten lobi (yang tampil publik) dibatasi admin
    // agar tidak bisa ditimpa/di-deface oleh guru/siswa mana pun.
    match /lobby_settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lobby_sections/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lobby_links/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi `settings` menyimpan dua jenis dokumen dengan sensitivitas berbeda:
    //  - `app_config`  : konfigurasi non-rahasia (tahun ajaran & semester aktif,
    //                    flag izin guru). Dibaca semua peran, ditulis admin.
    //  - `ai`, `backup_drive` : kredensial OAuth Google Drive dan API key AI
    //                    (terenkripsi AES-256-GCM), beserta folder tujuan dan
    //                    riwayat backup. HANYA boleh diakses Admin SDK dari
    //                    fungsi serverless di `src/api/`, tidak pernah dari
    //                    browser. Klien yang bisa menulis dokumen ini dapat
    //                    menghapus refresh token dan mematikan seluruh backup.
    //
    // Karena itu `settings` TIDAK dimasukkan ke allow-list wildcard di bawah:
    // hanya `app_config` yang diizinkan secara eksplisit, sisanya jatuh ke
    // penolakan default `match /{document=**}`.
    match /settings/app_config {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ========================================================================
    // KOLEKSI AKADEMIK — dibaca semua pengguna login, DITULIS hanya guru/admin.
    // Sebelumnya seluruh koleksi di sini bisa ditulis siswa mana pun (celah
    // integritas: siswa dapat mengubah nilai/absensi/keaktifan/kas/wali sendiri
    // atau milik orang lain). Kini siswa hanya boleh MEMBACA; penulisan (input
    // nilai, absensi, keaktifan, jurnal, pembayaran, plotting, wali, materi,
    // pengumuman, konfigurasi game/kuis) dibatasi peran guru/admin.
    // ========================================================================
    match /{collectionName}/{documentId} {
      allow read: if isSignedIn() && collectionName in [
        'mata_pelajaran',
        'kelas',
        'tahun_ajaran',
        'pengajaran',
        'pembelajaran',
        'anggota_kelas',
        'absensi',
        'catatan_khusus',
        'jurnal_guru',
        'nilai_tugas',
        'nilai_ujian',
        'bab',
        'tugas_bab',
        'ulangan_harian_kolom',
        'keaktifan_siswa',
        'item_pembayaran_buku',
        'pembayaran_buku',
        'wali_kelas',
        'materi_ai',
        'materi_ringkasan',
        'pengumuman',
        'pengumuman_ringkasan',
        'game_configs',
        'kuiz_paket',
        'kuiz_sesi',
        'kuiz_nilai_final',
        'rpm_drafts'
      ];
      allow write: if isStaff() && collectionName in [
        'mata_pelajaran',
        'kelas',
        'tahun_ajaran',
        'pengajaran',
        'pembelajaran',
        'anggota_kelas',
        'absensi',
        'catatan_khusus',
        'jurnal_guru',
        'nilai_tugas',
        'nilai_ujian',
        'bab',
        'tugas_bab',
        'ulangan_harian_kolom',
        'keaktifan_siswa',
        'item_pembayaran_buku',
        'pembayaran_buku',
        'wali_kelas',
        'materi_ai',
        'materi_ringkasan',
        'pengumuman',
        'pengumuman_ringkasan',
        'game_configs',
        'kuiz_paket',
        'kuiz_sesi',
        'kuiz_nilai_final',
        'rpm_drafts'
      ];
    }

    // ========================================================================
    // KOLEKSI MILIK/PARTISIPASI SISWA — dibaca & ditulis semua pengguna login.
    // Ini koleksi yang MEMANG ditulis siswa dari aplikasi:
    //  - ringkasan_siswa, absensi_ringkasan_siswa : ringkasan ditulis siswa saat
    //    membuka dashboard/nilai (dan juga oleh guru saat rebuild).
    //  - kas_kelas, kas_transaksi                 : bendahara siswa & wali kelas.
    //  - game_tokens                              : kuota main game per siswa.
    //  - kuiz_jawaban                             : jawaban ujian siswa.
    //  - pengumuman_reads                         : tanda baca pengumuman siswa.
    // Catatan: game_sessions, game_session_rekap, battle_*, materi_reads punya
    // blok khusus di atas dengan validasi bentuk payload — sengaja TIDAK diulang
    // di sini agar validasinya tetap berlaku (aturan bersifat OR).
    // ========================================================================
    match /{collectionName}/{documentId} {
      allow read, write: if isSignedIn() && collectionName in [
        'ringkasan_siswa',
        'absensi_ringkasan_siswa',
        'kas_kelas',
        'kas_transaksi',
        'game_tokens',
        'kuiz_jawaban',
        'pengumuman_reads'
      ];
    }

    match /chat_rooms/{roomId} {
      // Hanya peserta ruang yang boleh membaca/menulis. Membuat ruang baru wajib
      // menyertakan diri sendiri sebagai peserta. Ini menutup celah lama di mana
      // setiap pengguna login bisa membaca percakapan privat siapa pun.
      allow read: if isSignedIn() && request.auth.token.username in resource.data.participants;
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.auth.token.username in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.token.username in resource.data.participants;
      allow delete: if isSignedIn()
        && request.auth.token.username in resource.data.participants;
      match /messages/{msgId} {
        // Akses pesan mengikuti keanggotaan ruang induk.
        allow read, write: if isSignedIn()
          && request.auth.token.username in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
