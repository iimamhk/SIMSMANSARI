{
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/ai/generate-material-json.js": {
      "maxDuration": 300
    },
    "api/ai/generate-material.js": {
      "maxDuration": 300
    },
    "api/ai/generate-rpm.js": {
      "maxDuration": 60
    },
    "api/ai/model-options.js": {
      "maxDuration": 10
    },
    "api/ai/config.js": {
      "maxDuration": 30
    },
    "api/ai/test-connection.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/auth/users",
      "destination": "/api/auth/users.js"
    },
    {
      "source": "/api/auth/account",
      "destination": "/api/auth/account.js"
    },
    {
      "source": "/api/auth/contacts",
      "destination": "/api/auth/contacts.js"
    },
    {
      "source": "/api/ai/test-connection",
      "destination": "/api/ai/test-connection.js"
    },
    {
      "source": "/api/ai/config",
      "destination": "/api/ai/config.js"
    },
    {
      "source": "/api/ai/model-options",
      "destination": "/api/ai/model-options.js"
    },
    {
      "source": "/api/ai/generate-material",
      "destination": "/api/ai/generate-material.js"
    },
    {
      "source": "/api/ai/generate-material-json",
      "destination": "/api/ai/generate-material-json.js"
    },
    {
      "source": "/api/ai/generate-rpm",
      "destination": "/api/ai/generate-rpm.js"
    },
    {
      "source": "/firebase/(.*)",
      "destination": "/src/firebase/$1"
    },
    {
      "source": "/utils/(.*)",
      "destination": "/src/utils/$1"
    },
    {
      "source": "/layouts/(.*)",
      "destination": "/src/layouts/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/src/pages/$1"
    },
    {
      "source": "/",
      "destination": "/src/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
