# Contoh konfigurasi server lokal.
# Salin file ini menjadi .env lalu isi dengan nilai asli.
# PENTING: jangan commit file .env yang berisi API key asli.
# PENTING: untuk production / Vercel, isi env yang sama lewat dashboard Vercel,
# bukan dengan mengunggah file .env dari lokal.

# Provider AI yang sedang dipakai pada proyek ini saat ini adalah Groq,
# tetapi kode masih kompatibel dengan nama env lama IAMHC_*.
# Jika ingin paling aman dengan konfigurasi saat ini, isi tiga field di bawah ini.
IAMHC_API_KEY=sk-xxxxxxxxxxxxxxxx
IAMHC_BASE_URL=https://api.groq.com/openai/v1
IAMHC_MODEL=llama-3.3-70b-versatile

# Alternatif: kode juga mendukung nama env GROQ_* atau OPENAI_*.
# Pakai salah satu set saja agar tidak membingungkan.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# URL asal frontend yang diizinkan memanggil API.
# Pisahkan dengan koma. Kosongkan hanya untuk pengembangan lokal bila memang diperlukan.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Batas permintaan per IP.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

# Port backend lokal.
PORT=3000

# Jika hendak di-online-kan:
# 1. buka Vercel > Project Settings > Environment Variables
# 2. salin nama env yang dipakai di atas ke Vercel
# 3. isi nilai API key, base URL, dan model yang benar
# 4. simpan perubahan
# 5. redeploy project
# 6. tes /api/health dan /api/ai/test-connection
