# Contoh konfigurasi server. Salin ke file .env dan isi nilai aslinya.
# PENTING: JANGAN commit file .env yang berisi API key asli.

IAMHC_API_KEY=sk-xxxxxxxxxxxxxxxx
IAMHC_BASE_URL=https://api.iamhc.cn/v1
IAMHC_MODEL=gpt-4o-mini

# URL asal frontend yang diizinkan (pisahkan dengan koma). Kosongkan = izinkan semua (dev).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Batas permintaan per IP.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=900000

PORT=3000
